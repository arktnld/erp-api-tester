{
  "slug": "sgp",
  "name": "SGP",
  "description": "SGP: token + app no corpo; alguns endpoints de equipamento usam login básico.",
  "detect": [
    "sgp\\.net\\.br",
    "/api/ura"
  ],
  "baseUrlExample": "https://seuprovedor.sgp.net.br",
  "credentialHints": {
    "token": "Sistema → Ferramentas → Painel Admin → Tokens.",
    "app": "Nome do app gerado junto com o token.",
    "username": "Usuário do SGP (Sistema → Usuários). Só para reboot de CPE.",
    "password": "Senha desse usuário."
  },
  "probeEndpoint": "listar_tipos_de_ocorrencia",
  "firstCall": "cliente_por_cpf_cnpj",
  "authModes": [
    {
      "id": "default",
      "type": "body_fields",
      "label": "Autenticação SGP",
      "fields": [
        {
          "key": "app",
          "label": "Nome de app",
          "hidden": false,
          "default": "",
          "placeholder": ""
        },
        {
          "key": "token",
          "label": "Token",
          "hidden": false,
          "default": "",
          "placeholder": ""
        }
      ]
    },
    {
      "id": "basic",
      "type": "basic",
      "label": "Auth Básica",
      "fields": [
        {
          "key": "username",
          "label": "Usuário",
          "hidden": false,
          "default": "",
          "placeholder": ""
        },
        {
          "key": "password",
          "label": "Senha",
          "hidden": false,
          "default": "",
          "placeholder": ""
        }
      ]
    }
  ],
