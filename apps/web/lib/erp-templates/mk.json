{
  "slug": "mk",
  "name": "MKSolutions",
  "description": "MK Solutions: token obtido no WSAutenticacao (sys, token, senha e serviço).",
  "detect": [
    "/mk/?$",
    "mk-?solutions"
  ],
  "baseUrlExample": "https://mk.seuprovedor.com.br/mk",
  "credentialHints": {
    "SYS": "Código do sistema, ex.: MK0.",
    "TOKEN": "Chave de acesso do usuário de integração no MK.",
    "PASSWORD": "Senha desse usuário.",
    "SERVICE": "Código do serviço liberado para a integração."
  },
  "probeEndpoint": null,
  "firstCall": "cliente_por_cpf_cnpj",
  "authModes": [
    {
      "id": "default",
      "type": "token_endpoint",
      "label": "Autenticação MK",
      "fields": [
        {
          "key": "SYS",
          "label": "Sistema (SYS)",
          "placeholder": ""
        },
        {
          "key": "TOKEN",
          "label": "Token de acesso",
          "placeholder": ""
        },
        {
          "key": "PASSWORD",
          "label": "Senha",
          "placeholder": ""
        },
        {
          "key": "SERVICE",
          "label": "Código do serviço",
          "placeholder": ""
        }
      ],
      "tokenPath": "Token",
      "tokenEndpoint": "obter_token"
    }
  ],
  "endpoints": [
    {
      "key": "cliente_por_cpf_cnpj",
      "name": "Cliente por CPF/CNPJ",
      "method": "GET",
      "pathTemplate": "/WSMKConsultaDoc.rule?sys={SYS}&token={TOKEN}&doc={cpfcnpj}",
      "bodyTemplate": "",
      "headers": "{}",
      "group": "Cliente",
      "requiresClient": true,
      "isModification": false,
      "notes": "",
      "authMode": ""
    },
    {
      "key": "clientes_por_faixa_de_codigo",
      "name": "Clientes por faixa de código",
      "method": "GET",
      "pathTemplate": "/WSMKConsultaClientes.rule?sys={SYS}&token={TOKEN}&cd_cliente_inicio={cd_cliente_inicio}&cd_cliente_fim={cd_cliente_fim}",
      "bodyTemplate": "",
      "headers": "{}",
      "group": "Cliente",
      "requiresClient": true,
      "isModification": false,
      "notes": "",
      "authMode": ""
    },
    {
      "key": "contratos_do_cliente",
